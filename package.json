{
  "name": "movie-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build && node scripts/generate-sitemap.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "graph:setup": "node scripts/graphify-setup.mjs",
    "graph:build": "node scripts/graphify.mjs update . --no-cluster",
    "graph:update": "node scripts/graphify.mjs update .",
    "graph:query": "node scripts/graphify.mjs query",
    "graph:explain": "node scripts/graphify.mjs explain",
    "graph:hubs": "node scripts/graphify.mjs god-nodes",
    "graph:affected": "node scripts/graphify.mjs affected"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "appwrite": "^21.5.0",
    "flowbite": "^4.0.1",
    "flowbite-react": "^0.12.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^4.1.18",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  }
}
